# Top-level .editorconfig settings
root = true

[*.cs]
indent_style = space
indent_size = 4
insert_final_newline = true
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true

# ASP.NET Core files
[*.{cs,aspx,ascmd,cshtml}]
dotnet_sort_system_directives_first = true

# C# files
[*.cs]
# New line preferences
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_new_line_before_members_in_object_initializers = true
csharp_new_line_before_members_in_anonymous_types = true
csharp_new_line_between_query_expression_clauses = true

# Indentation preferences
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_indent_labels_one_less_level = true

# Parameter formatting
dotnet_style_parentheses_in_arithmetic_binary_operators = always_for_missing
dotnet_style_parentheses_in_other_binary_operators = always_for_missing
dotnet_style_parentheses_in_unary_binary_operators = always_for_missing

# Style preferences
dotnet_style_object_initializer = true:suggestions
dotnet_style_collection_initializer = true:suggestions
dotnet_style_explicit_tuple_names = always:suggestions
dotnet_style_null_propagation = never
dotnet_style_coalesce_expression = never:suggestions

# Expression body preferences
csharp_expression_body_declarations = method:warning
csharp_expression_body_declarations = operator:warning

# Using directive preferences
dotnet_sort_using_directives_by_alphabetical_order = true
csharp_using_directive_placement = outside_namespace:suggestions

# Code quality
dotnet_diagnostic.CA1800.severity = none
dotnet_diagnostic.CS8618.severity = none
dotnet_diagnostic.CS8604.severity = none

[*.json]
indent_style = space
indent_size = 2

[*.xml]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[{Makefile,makefile}]
indent_style = tab